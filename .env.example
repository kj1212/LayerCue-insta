# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# Meta 앱 대시보드 > Instagram API > API setup with Instagram login > Generate access tokens 에서 받은 장기 토큰(60일)
IG_ACCESS_TOKEN=

# 비워 두고 `python3 publish.py whoami` 를 실행하면 자동으로 채워진다.
IG_USER_ID=

# 인스타 서버가 사진·영상을 받아갈 공개 주소(이 저장소의 GitHub Pages). 저장소 경로가 그대로 붙는다.
# 예: .../posts/2026-10-29-v0.9.12/1.jpg — 발행 전에 커밋·푸시해서 Pages 에 올라가 있어야 한다.
MEDIA_BASE_URL=https://kj1212.github.io/LayerCue-insta

IG_API_VERSION=v23.0
