# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.

# 그래프 API 탐색기에서 받은 페이스북 사용자 토큰. 받은 직후 `python3 publish.py refresh` 로 60일짜리로 바꾼다.
IG_ACCESS_TOKEN=

# Meta 앱 대시보드 > 앱 설정 > 기본 설정의 앱 ID / 앱 시크릿 코드. refresh 에만 쓴다.
FB_APP_ID=1444173200564298
FB_APP_SECRET=

# 비워 두고 `python3 publish.py whoami` 를 실행하면 자동으로 채워진다.
IG_USER_ID=
IG_USERNAME=layercue

# 페이스북 LayerCue 페이지. 값이 있으면 같은 게시물을 페이지에도 올린다(비우면 인스타에만).
FB_PAGE_ID=1474616572392461

# 인스타 서버가 사진·영상을 받아갈 공개 주소(이 저장소의 GitHub Pages). 저장소 경로가 그대로 붙는다.
# 예: .../posts/2026-10-29-v0.9.12/1.jpg — 발행 전에 커밋·푸시해서 Pages 에 올라가 있어야 한다.
MEDIA_BASE_URL=https://kj1212.github.io/LayerCue-insta

IG_API_VERSION=v26.0
